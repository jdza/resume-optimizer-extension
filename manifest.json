{
  "manifest_version": 3,
  "name": "Resume Optimizer",
  "description": "Generate a customized resume based on job postings.",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/",
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
